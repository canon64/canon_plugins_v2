<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MainGameMilkSpray</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <KKSDir Condition="'$(KKSDir)'==''">F:\kks</KKSDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="TubeGeometry.cs" />
    <Compile Remove="ShaderBuild\**\*.cs" />
    <EmbeddedResource Include="Resources\milkliquid.bundle" LogicalName="MainGameMilkSpray.milkliquid.bundle" />
    <Reference Include="BepInEx"><HintPath>$(KKSDir)\BepInEx\core\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(KKSDir)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(KKSDir)\KoikatsuSunshine_Data\Managed\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KKSDir)\KoikatsuSunshine_Data\Managed\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KKSDir)\KoikatsuSunshine_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(KKSDir)\KoikatsuSunshine_Data\Managed\UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(KKSDir)\KoikatsuSunshine_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireLiquidShader" BeforeTargets="BeforeBuild" Condition="!Exists('Resources\milkliquid.bundle')">
    <Error Text="Run MainGameMilkSpray\BuildShader.ps1 with Unity 2019.4.9f1 before building the DLL." />
  </Target>
</Project>
